# Use a separate Clerk Production instance for the deployed beta. Set real
# values only in Vercel's Environment Variables; never commit an .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Product analytics is disabled until these are set. Crawlback identifies only
# signed-in Clerk user IDs and tracks query-free page views.
# Create a PostHog Cloud project in the EU region, then copy its project token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
